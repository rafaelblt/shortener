#: shortener/infra/templates/jinja/auth/verification_email.py:24
#, python-format
msgid "Verification Email - %(app_name)s"
msgstr "Verificação de Email - %(app_name)s"

#: shortener/infra/templates/jinja/auth/verification_email.txt:1
#, python-format
msgid "Hello, %(user_name)s!"
msgstr "Olá, %(user_name)s!"

#: shortener/infra/templates/jinja/auth/verification_email.txt:3
#, python-format
msgid "Thank you for signing up for %(app_name)s."
msgstr "Obrigado por se cadastrar em %(app_name)s."

#: shortener/infra/templates/jinja/auth/verification_email.txt:4
msgid "To verify your account, use the link below:"
msgstr "Para completar a verificação da sua conta, clique no link abaixo:"

#: shortener/infra/templates/jinja/auth/verification_email.txt:8
#, python-format
msgid "This link will expire in %(expires_minutes)s minutes."
msgstr "Esse link vai expirar em %(expires_minutes)s minutos."

#: shortener/infra/templates/jinja/auth/verification_email.txt:9
msgid "If you did not create this account, please ignore this message."
msgstr "Se você não solicitou esse cadastro, por favor ignore esse email."

